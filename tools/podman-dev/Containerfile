# Dev image for pgeu-system + PgUS skin under rootless podman.
# Build from the pgeu-system repo root:
#   podman build -t localhost/pgeu-dev-app -f tools/podman-dev/Containerfile .
FROM docker.io/library/python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends \
        build-essential \
        libjpeg-dev zlib1g-dev libpng-dev libfreetype6-dev \
        libffi-dev libssl-dev \
        libcairo2 \
        libmagic1 \
        media-types \
        fonts-dejavu-core \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    # settings.py FONTROOT default expects the pre-bookworm dejavu path
    && ln -s /usr/share/fonts/truetype/dejavu /usr/share/fonts/truetype/ttf-dejavu

COPY tools/devsetup/dev_requirements.txt tools/devsetup/dev_requirements_full.txt /tmp/req/
RUN pip install --no-cache-dir \
        -r /tmp/req/dev_requirements.txt \
        -r /tmp/req/dev_requirements_full.txt \
        uwsgi \
    && rm -rf /tmp/req

# Stable path for the uwsgi static-map of Django admin assets
RUN ln -s "$(python3 -c 'import django, os; print(os.path.join(os.path.dirname(django.__file__), "contrib/admin/static/admin"))')" \
        /opt/django-admin-static

WORKDIR /app
ENTRYPOINT ["/app/tools/podman-dev/entrypoint.sh"]
